# Use Docker to run Vagrant with libvirt support, as using vagrant-libvirt plugin is unstable on Arch Linux
# Official documentation: https://vagrant-libvirt.github.io/vagrant-libvirt/installation.html
#
# Test with "vagrant status"

REAL_PWD="$(realpath ${PWD})"
PROJECT_DIR="${REAL_PWD}"
if [ "${PROJECT_DIR##*/}" = _vagrant ] ; then
    # Share the parent directory
    PROJECT_DIR="${PROJECT_DIR%/_vagrant}"
fi

DOCKER_FLAGS=()

if [ -t 0 ] ; then
    # stdin is a TTY
    DOCKER_FLAGS+=("-it")
else
    DOCKER_FLAGS+=("-i")
fi

exec docker run --rm \
  -e LIBVIRT_DEFAULT_URI \
  -v /var/run/libvirt/:/var/run/libvirt/ \
  -v ~/.vagrant.d:/.vagrant.d \
  -v "${PROJECT_DIR}:${PROJECT_DIR}" \
  -w "${REAL_PWD}" \
  --network host \
  "${DOCKER_FLAGS[@]}" \
  vagrantlibvirt/vagrant-libvirt:latest \
    vagrant "$@"
